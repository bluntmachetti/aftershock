# Runtime secrets and deployment host settings.
# Copy to .env on the server and fill in real values. Do not commit .env.

# Required for live LLM arms.
DASHSCOPE_API_KEY=

# Required for public deployments; protects mutating observatory endpoints.
OBSERVATORY_TOKEN=

# Host interface the app port (8788) binds to. Default 127.0.0.1 (loopback-only;
# prod sits behind Caddy). Set to 0.0.0.0 on a LAN/staging box to reach it directly
# at http://<host>:8788. Leave default on the public prod box.
OBSERVATORY_BIND=

# Set to 1 on a judge-facing/demo box to run the server-side ambient demo loop: the
# Live tab streams a looping scripted negotiation over the read-only WS with no client
# action. Leave empty for normal/dev deployments (no background runs).
AFTERSHOCK_DEMO_MODE=

# Friendly public hostname for the Alibaba Cloud deployment.
# Example: aftershock.example.com
AFTERSHOCK_HOSTNAME=
OBSERVATORY_ORIGIN=https://aftershock.example.com
